# Settings for `docker compose up`. Copy to `.env` beside docker-compose.yml —
# compose reads that file automatically:
#
#     cp .env.example .env
#
# Only GEMINI_API_KEY is required. Everything left empty uses the default in the
# service's config.py (shown here after "default:").

# ── Gemini ───────────────────────────────────────────────────────────────
# Used by the worker for summaries, the impact check and policy matching.
# Create a key at https://ai.google.dev/gemini-api
GEMINI_API_KEY=
# default: gemini-3.5-flash
GEMINI_MODEL_NAME=
# default: gemini-embedding-001
GEMINI_EMBEDDING_MODEL_NAME=

# ── Agent ────────────────────────────────────────────────────────────────
# Minutes between checks of the regulator sites (default 60)
WATCH_INTERVAL_MINUTES=
# Circulars published before this many days ago are skipped; new policies and new
# companies are checked against this many days of circulars (default 30)
LOOKBACK_DAYS=
# Pages of each circular sent to OCR (default 20)
OCR_MAX_PAGES=
# Closest policies Gemini checks per circular (default 3)
MATCH_TOP_K=
# Workers running side by side. The watcher and the api put tasks on a Redis stream and
# each task goes to one worker; OCR still reads one page at a time on the GPU, so extra
# workers mainly speed up the Gemini steps (default 1)
WORKERS=
# Minutes between checks of Postgres for work whose task went missing (default 15)
RECONCILE_MINUTES=

# ── Database ─────────────────────────────────────────────────────────────
# Changing these after the first run needs the volume dropped: docker compose down -v
POSTGRES_USER=rci
POSTGRES_PASSWORD=rci
POSTGRES_DB=rci
# Host port, for services run with `uv run` (default 5432)
POSTGRES_PORT=

# ── Redis: the task stream ───────────────────────────────────────────────
# Host port, for services run with `uv run` (default 6379)
REDIS_PORT=

# ── S3: Floci on the host (endpoint set in docker-compose.yml) ───────────
# The bucket must exist.
S3_BUCKET=rci
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# ── API and the test console ─────────────────────────────────────────────
API_PORT=8000
FRONTEND_PORT=8080
# Browser origins allowed to call the API, comma-separated (default: any)
CORS_ORIGINS=
# Signs login tokens. Empty: a random key is made on first start and kept in Postgres
JWT_SECRET=
# Hours a login lasts (default 12)
TOKEN_HOURS=
