# For running the worker on the host (`uv run python main.py`). Copy to .env beside main.py.
# `docker compose up` sets these itself, from the .env in the repo root.

DATABASE_URL=postgresql+psycopg://rci:rci@localhost:5432/rci

# The task stream (docker compose up -d redis publishes it on :6379)
REDIS_URL=redis://localhost:6379/0

# Where the watcher stored the PDFs: Floci (local S3) on :4566
S3_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=rci
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# The ocr service (docker compose up -d ocr publishes it on :8001)
OCR_URL=http://localhost:8001/v1
OCR_MAX_PAGES=20

# Gemini. Only the key is required. Create one at https://ai.google.dev/gemini-api
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL_NAME=gemini-embedding-001
# Characters of circular text sent for the summary
LLM_MAX_CHARS=100000

# The task lanes this worker takes, each with a loop of its own: pdf (reading PDFs on
# the GPU, minutes each) and main (everything else, a few Gemini calls each). In Docker,
# the reader service takes pdf and the worker service takes main.
LANES=pdf,main

MATCH_TOP_K=3
LOOKBACK_DAYS=30

# The queue: take over a dead worker's task after this long (a live worker re-claims
# its task every minute); wait this long while OCR, Gemini or Redis is down
CLAIM_IDLE_SECONDS=300
RETRY_SECONDS=60
