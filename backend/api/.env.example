# For running the api on the host (`uv run uvicorn main:app --reload`). Copy to .env beside main.py.
# `docker compose up` sets these itself, from the .env in the repo root.

DATABASE_URL=postgresql+psycopg://rci:rci@localhost:5432/rci

# The task stream the workers read (docker compose up -d redis publishes it on :6379)
REDIS_URL=redis://localhost:6379/0

# Browser origins allowed to call the API, comma-separated ("*" = any)
CORS_ORIGINS=*

# Signs login tokens. Empty: a random key is made on first start and kept in Postgres
JWT_SECRET=
# Hours a login lasts
TOKEN_HOURS=12

# Must match the worker's: how far back a company's circulars count as recent
LOOKBACK_DAYS=30
