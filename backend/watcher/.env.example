# For running the watcher on the host (`uv run python main.py`). Copy to .env beside main.py.
# `docker compose up` sets all of these itself, from the .env in the repo root.

DATABASE_URL=postgresql+psycopg://rci:rci@localhost:5432/rci

# Where PDFs are stored. Floci (local S3) on :4566; leave S3_ENDPOINT_URL empty for real AWS.
S3_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=rci
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# Minutes between checks of the regulator sites. 0 = check once and exit.
INTERVAL_MINUTES=0
